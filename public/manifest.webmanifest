{
  "id": "/",
  "name": "Still — Private Authenticator",
  "short_name": "Still",
  "description": "A local-first two-factor authenticator. Your codes and keys stay encrypted on this device, and the app keeps working with no connection.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
