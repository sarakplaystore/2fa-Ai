<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keystore keys cannot be restored to another install. Don't copy a
         vault that would be permanently inaccessible without its key. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
