# Copy to .env next to docker-compose.yml to set these without exporting them
# in your shell. Everything here is optional; the defaults are safe for local
# use. Never commit a filled-in .env.

# --- TLS front end (docker compose --profile tls) --------------------------
# Domain Caddy should serve. Use a real domain for a public deployment
# (DNS must point at this host and ports 80/443 must be reachable for ACME).
# Leave unset to use "localhost" with Caddy's internal certificate authority.
#STILL_SITE_ADDRESS=auth.example.com

# --- static server (scripts/serve.py, also the container entrypoint) --------
# Bind interface and port inside the container. Keep these unless you also
# change the published port mapping in docker-compose.yml.
#HOST=0.0.0.0
#PORT=8080
#DIST_DIR=/app/dist

# Enable HSTS only when the app is really reached over HTTPS.
#STILL_HSTS_MAX_AGE=31536000

# Restrict which Host headers are served; anything else gets HTTP 421.
#STILL_ALLOWED_HOSTS=auth.example.com

# Header policy sent in addition to the CSP meta tag in index.html.
#STILL_CSP=frame-ancestors 'none'; base-uri 'self'; form-action 'none'

# Log only responses with status >= 400.
#STILL_QUIET=1
